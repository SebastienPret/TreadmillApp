<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:resources="clr-namespace:TreadmillApp.Resources.Strings"
             xmlns:viewmodels="clr-namespace:TreadmillApp.ViewModels"
             x:Class="TreadmillApp.Views.SettingsPage"
             x:DataType="viewmodels:SettingsViewModel">

    <ContentPage.BindingContext>
        <viewmodels:SettingsViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Spacing="25" Padding="20">

            <!-- Section Langue -->
            <Border Style="{StaticResource CardBorder}" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{x:Static resources:AppResources.Lbl_Language}" Style="{StaticResource SectionLabel}"/>

                    <HorizontalStackLayout Spacing="15" VerticalOptions="Center">
                        <Label Text="{x:Static resources:AppResources.Lbl_Language_App}" Style="{StaticResource SubtleLabel}"/>

                        <Picker Title="{x:Static resources:AppResources.Lbl_Choose_Language}"
                                WidthRequest="120"
                                SelectedIndex="{Binding SelectedLanguageIndex}">
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>English</x:String>
                                    <x:String>Français</x:String>
                                    <x:String>Nederlands</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
            
            <!-- selections de Themes -->
            <Border Style="{StaticResource CardBorder}" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{x:Static resources:AppResources.Lbl_Theme}" Style="{StaticResource SectionLabel}"/>
                    <Picker x:Name="StylePicker" Title="{x:Static resources:AppResources.Lbl_Choose_Theme}" /> 
                </VerticalStackLayout>
            </Border>

            <!-- Section Options de Séances -->
            <Border Style="{StaticResource CardBorder}" Padding="15">
                <VerticalStackLayout Spacing="15">
                    <Label Text="{x:Static resources:AppResources.Lbl_Workout_Options}" Style="{StaticResource SectionLabel}"/>

                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="15">
                        <!-- Compte à rebours 5s -->
                        <Label Grid.Row="0" Grid.Column="0" 
                               Text="{x:Static resources:AppResources.Lbl_Countdown_5s}" 
                               Style="{StaticResource SubtleLabel}" VerticalTextAlignment="Center"/>
                        <Switch Grid.Row="0" Grid.Column="1" 
                                IsToggled="{Binding EnableCountdown}"/>

                        <!-- Signaux Audio -->
                        <Label Grid.Row="1" Grid.Column="0" 
                               Text="{x:Static resources:AppResources.Lbl_Audio_Alerts}"  
                               Style="{StaticResource SubtleLabel}" VerticalTextAlignment="Center"/>
                        <Switch Grid.Row="1" Grid.Column="1" 
                                IsToggled="{Binding EnableAudioAlerts}"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Section Données & Application -->
            <Border Style="{StaticResource CardBorder}" Padding="15">
                <VerticalStackLayout Spacing="15">
                    <Label Text="{x:Static resources:AppResources.Lbl_About}" Style="{StaticResource SectionLabel}"/>

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="{x:Static resources:AppResources.Lbl_Version}" Style="{StaticResource SubtleLabel}"/>
                        <Label Text="{Binding VersionText}" Style="{StaticResource SubtleLabel}"/>
                    </HorizontalStackLayout>

                    <!-- Réinitialiser les programmes enregistrés -->
                    <Button Text="{x:Static resources:AppResources.Btn_Reset_Data}" 
                            Command="{Binding ResetDataCommand}" 
                            Style="{StaticResource DangerButton}"
                            Margin="0,10,0,0"/>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>