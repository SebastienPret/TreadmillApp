<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:resources="clr-namespace:TreadmillApp.Resources.Strings"
             xmlns:viewmodels="clr-namespace:TreadmillApp.ViewModels"
             x:Class="TreadmillApp.Views.SettingsPage"
             Title="Paramètres"
             BackgroundColor="#121212">

    <ContentPage.BindingContext>
        <viewmodels:SettingsViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Spacing="25" Padding="20">

            <!-- Section Langue -->
            <Border BackgroundColor="#1E1E1E" StrokeShape="RoundRectangle 10" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{x:Static resources:AppResources.Lbl_Language}" FontSize="18" TextColor="Yellow" FontAttributes="Bold"/>

                    <HorizontalStackLayout Spacing="15" VerticalOptions="Center">
                        <Label Text="{x:Static resources:AppResources.Lbl_Language_App}" TextColor="White" VerticalTextAlignment="Center"/>

                        <Picker Title="{x:Static resources:AppResources.Lbl_Choose_Language}"
                                TextColor="Cyan"
                                WidthRequest="120"
                                SelectedIndex="{Binding SelectedLanguageIndex}">
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>English</x:String>
                                    <x:String>Français</x:String>
                                    <x:String>Nederlands</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Section Options de Séances -->
            <Border BackgroundColor="#1E1E1E" StrokeShape="RoundRectangle 10" Padding="15">
                <VerticalStackLayout Spacing="15">
                    <Label Text="{x:Static resources:AppResources.Lbl_Workout_Options}" FontSize="18" TextColor="Yellow" FontAttributes="Bold"/>

                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="15">
                        <!-- Compte à rebours 5s -->
                        <Label Grid.Row="0" Grid.Column="0" 
                               Text="{x:Static resources:AppResources.Lbl_Countdown_5s}" 
                               TextColor="White" VerticalTextAlignment="Center"/>
                        <Switch Grid.Row="0" Grid.Column="1" 
                                IsToggled="{Binding EnableCountdown}"/>

                        <!-- Signaux Audio -->
                        <Label Grid.Row="1" Grid.Column="0" 
                               Text="{x:Static resources:AppResources.Lbl_Audio_Alerts}"  
                               TextColor="White" VerticalTextAlignment="Center"/>
                        <Switch Grid.Row="1" Grid.Column="1" 
                                IsToggled="{Binding EnableAudioAlerts}"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Section Données & Application -->
            <Border BackgroundColor="#1E1E1E" StrokeShape="RoundRectangle 10" Padding="15">
                <VerticalStackLayout Spacing="15">
                    <Label Text="{x:Static resources:AppResources.Lbl_About}" FontSize="18" TextColor="Yellow" FontAttributes="Bold"/>

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="{x:Static resources:AppResources.Lbl_Version}" TextColor="Gray"/>
                        <Label Text="1.0.0 (FTMS BLE)" TextColor="White" FontAttributes="Bold"/>
                    </HorizontalStackLayout>

                    <!-- Réinitialiser les programmes enregistrés -->
                    <Button Text="{x:Static resources:AppResources.Btn_Reset_Data}" 
                            Command="{Binding ResetDataCommand}" 
                            BackgroundColor="#D32F2F" 
                            TextColor="White" 
                            Margin="0,10,0,0"/>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>