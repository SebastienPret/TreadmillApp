<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:resources="clr-namespace:TreadmillApp.Resources.Strings"
             xmlns:viewmodels="clr-namespace:TreadmillApp.ViewModels"
             x:Class="TreadmillApp.Views.DashboardPage">

    <ContentPage.BindingContext>
        <viewmodels:DashboardViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="25" HorizontalOptions="Center" VerticalOptions="Start">

            <!-- Connexion Bluetooth -->
            <Button Text="{Binding ConnectButtonText}"
                    Command="{Binding OpenScanCommand}"
                    Style="{StaticResource PrimaryButton}"
                    WidthRequest="300">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsConnected}" Value="True">
                        <Setter Property="BackgroundColor" Value="{DynamicResource SuccessColor}" />
                        <Setter Property="TextColor" Value="#FFFFFF" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Label Text="{Binding DeviceStatus}" Style="{StaticResource HintLabel}" HorizontalOptions="Center"/>

            <!-- Indicateurs Live -->
            <HorizontalStackLayout Spacing="40" HorizontalOptions="Center">
                <VerticalStackLayout>
                    <Label Text="{x:Static resources:AppResources.Lbl_Speed}" Style="{StaticResource SectionLabel}" HorizontalOptions="Center" TextTransform="Uppercase"/>
                    <Label Text="{Binding CurrentSpeed}" FontSize="48" Style="{StaticResource ValueLabel}" HorizontalOptions="Center"/>
                    <Label Text="{x:Static resources:AppResources.Lbl_Km_H}" Style="{StaticResource HintLabel}" HorizontalOptions="Center"/>
                </VerticalStackLayout>
                <VerticalStackLayout>
                    <Label Text="{x:Static resources:AppResources.Lbl_Pace}" Style="{StaticResource SectionLabel}" HorizontalOptions="Center" TextTransform="Uppercase"/>
                    <Label Text="{Binding CurrentPace}" FontSize="48" Style="{StaticResource ValueLabel}" HorizontalOptions="Center"/>
                    <Label Text="{x:Static resources:AppResources.Lbl_Min_Km}" Style="{StaticResource HintLabel}" HorizontalOptions="Center"/>
                </VerticalStackLayout>
                <VerticalStackLayout>
                    <Label Text="{x:Static resources:AppResources.Lbl_Incline}" Style="{StaticResource SectionLabel}" HorizontalOptions="Center" TextTransform="Uppercase"/>
                    <Label Text="{Binding CurrentIncline}" FontSize="48" Style="{StaticResource ValueLabel}" HorizontalOptions="Center"/>
                    <Label Text="%" Style="{StaticResource HintLabel}" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </HorizontalStackLayout>

            <Label Text="{Binding StatusRun}" Style="{StaticResource StatusLabel}" FontSize="35"/>

            <!-- Contrôles Manuels (activés/désactivés via IsConnected) -->
            <VerticalStackLayout Spacing="20" IsEnabled="{Binding IsConnected}">
                <HorizontalStackLayout Spacing="15" HorizontalOptions="Center">
                    <Button Text="{x:Static resources:AppResources.Lbl_Speed_Up}" Command="{Binding DecreaseSpeedCommand}" MinimumWidthRequest="100" Style="{StaticResource SecondaryButton}"/>
                    <Button Text="{x:Static resources:AppResources.Lbl_Speed_Down}" Command="{Binding IncreaseSpeedCommand}" MinimumWidthRequest="100" Style="{StaticResource SecondaryButton}"/>
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="15" HorizontalOptions="Center">
                    <Button Text="{x:Static resources:AppResources.Lbl_Incline_Down}" Command="{Binding DecreaseInclineCommand}" MinimumWidthRequest="100" Style="{StaticResource SecondaryButton}"/>
                    <Button Text="{x:Static resources:AppResources.Lbl_Incline_Up}" Command="{Binding IncreaseInclineCommand}" MinimumWidthRequest="100" Style="{StaticResource SecondaryButton}"/>
                </HorizontalStackLayout>

                <!-- Start / Stop -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="15"  HorizontalOptions="Center">
                    <Button Grid.Column="0" Text="{x:Static resources:AppResources.Btn_Start}" MinimumWidthRequest="100" Command="{Binding StartCommand}" Style="{StaticResource SuccessButton}"/>
                    <Button Grid.Column="1" Text="{x:Static resources:AppResources.Btn_Stop}" MinimumWidthRequest="100" Command="{Binding StopCommand}" Style="{StaticResource DangerButton}"/>
                </Grid>
            </VerticalStackLayout>

            <!-- Lancer le Plan d'Intervalles -->
            <Button Text="{x:Static resources:AppResources.Btn_Run_Plan}" Command="{Binding RunPlanCommand}" Style="{StaticResource PrimaryButton}"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>