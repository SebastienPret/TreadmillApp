<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:resources="clr-namespace:TreadmillApp.Resources.Strings"
             x:Class="TreadmillApp.Views.DashboardPage"
             BackgroundColor="#121212">

    <VerticalStackLayout Spacing="20" Padding="25" HorizontalOptions="Center" VerticalOptions="Center">

        <!-- Connexion Bluetooth -->
        <Button x:Name="BtnConnect" Text="{x:Static resources:AppResources.Btn_Search_Treadmill}" Clicked="OnOpenScanClicked" BackgroundColor="#2196F3" TextColor="White" WidthRequest="300"/>
        <Label x:Name="LblDeviceStatus" Text="{x:Static resources:AppResources.Lbl_Device_Status}" FontSize="14" TextColor="Gray" HorizontalOptions="Center"/>

        <!-- Indicateurs Live -->
        <HorizontalStackLayout Spacing="40" HorizontalOptions="Center">
            <VerticalStackLayout>
                <Label Text="{x:Static resources:AppResources.Lbl_Speed}" TextColor="Gray" FontSize="12" HorizontalOptions="Center" TextTransform="Uppercase"/>
                <Label x:Name="LblCurrentSpeed" Text="0,0" FontSize="48" TextColor="Cyan" HorizontalOptions="Center" PropertyChanged ="PaceFormatted"/>
                <Label Text="{x:Static resources:AppResources.Lbl_Km_H}" TextColor="Gray" HorizontalOptions="Center"/>
            </VerticalStackLayout>
            <VerticalStackLayout>
                <Label Text="{x:Static resources:AppResources.Lbl_Pace}" TextColor="Gray" FontSize="12" HorizontalOptions="Center" TextTransform="Uppercase"/>
                <Label x:Name="LblCurrentPace" Text="0:00" FontSize="48" TextColor="Cyan" HorizontalOptions="Center" />
                <Label Text="{x:Static resources:AppResources.Lbl_Min_Km}" TextColor="Gray" HorizontalOptions="Center"/>
            </VerticalStackLayout>
            <VerticalStackLayout>
                <Label Text="{x:Static resources:AppResources.Lbl_Incline}" TextColor="Gray" FontSize="12" HorizontalOptions="Center" TextTransform="Uppercase"/>
                <Label x:Name="LblCurrentIncline" Text="0" FontSize="48" TextColor="Orange" HorizontalOptions="Center" />
                <Label Text="%" TextColor="Gray" HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </HorizontalStackLayout>

        <Label x:Name="LblStatus" Text="{x:Static resources:AppResources.Lbl_Status_Run}" FontSize="18" TextColor="Yellow" HorizontalOptions="Center"/>

        <!-- Contrôles Manuels -->
        <HorizontalStackLayout Spacing="15" HorizontalOptions="Center">
            <Button Text="{x:Static resources:AppResources.Lbl_Speed_Up}" Clicked="OnDecreaseSpeed" MinimumWidthRequest="100" BackgroundColor="#333" TextColor="White"/>
            <Button Text="{x:Static resources:AppResources.Lbl_Speed_Down}" Clicked="OnIncreaseSpeed" MinimumWidthRequest="100" BackgroundColor="#333" TextColor="White"/>
        </HorizontalStackLayout>

        <HorizontalStackLayout Spacing="15" HorizontalOptions="Center">
            <Button Text="{x:Static resources:AppResources.Lbl_Incline_Down}" Clicked="OnDecreaseIncline" MinimumWidthRequest="100" BackgroundColor="#333" TextColor="White"/>
            <Button Text="{x:Static resources:AppResources.Lbl_Incline_Up}" Clicked="OnIncreaseIncline" MinimumWidthRequest="100" BackgroundColor="#333" TextColor="White"/>
        </HorizontalStackLayout>

        <!-- Start / Stop -->
        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" WidthRequest="300">
            <Button Grid.Column="0" Text="{x:Static resources:AppResources.Btn_Start}" Clicked="OnStartClicked" BackgroundColor="#4CAF50" TextColor="White" FontAttributes="Bold"/>
            <Button Grid.Column="1" Text="{x:Static resources:AppResources.Btn_Stop}" Clicked="OnStopClicked" BackgroundColor="#F44336" TextColor="White" FontAttributes="Bold"/>
        </Grid>

        <!-- Lancer le Plan d'Intervalles -->
        <Button Text="{x:Static resources:AppResources.Btn_Run_Plan}" Clicked="OnRunPlanClicked" BackgroundColor="#FF5722" TextColor="White" WidthRequest="300"/>

    </VerticalStackLayout>
</ContentPage>