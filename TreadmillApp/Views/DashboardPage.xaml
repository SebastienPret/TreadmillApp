<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:resources="clr-namespace:TreadmillApp.Resources.Strings"
             xmlns:viewmodels="clr-namespace:TreadmillApp.ViewModels"
             x:Class="TreadmillApp.Views.DashboardPage"
             BackgroundColor="#121212">

    <ContentPage.BindingContext>
        <viewmodels:DashboardViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="25" HorizontalOptions="Center" VerticalOptions="Start">

            <!-- Connexion Bluetooth -->
            <Button Text="{Binding ConnectButtonText}" 
                    Command="{Binding OpenScanCommand}" 
                    BackgroundColor="{Binding ConnectButtonBackgroundColor}" 
                    TextColor="White" WidthRequest="300"/>
            <Label Text="{Binding DeviceStatus}" FontSize="14" TextColor="Gray" HorizontalOptions="Center"/>

            <!-- Indicateurs Live -->
            <HorizontalStackLayout Spacing="40" HorizontalOptions="Center">
                <VerticalStackLayout>
                    <Label Text="{x:Static resources:AppResources.Lbl_Speed}" TextColor="Gray" FontSize="12" HorizontalOptions="Center" TextTransform="Uppercase"/>
                    <Label Text="{Binding CurrentSpeed}" FontSize="48" TextColor="Cyan" HorizontalOptions="Center"/>
                    <Label Text="{x:Static resources:AppResources.Lbl_Km_H}" TextColor="Gray" HorizontalOptions="Center"/>
                </VerticalStackLayout>
                <VerticalStackLayout>
                    <Label Text="{x:Static resources:AppResources.Lbl_Pace}" TextColor="Gray" FontSize="12" HorizontalOptions="Center" TextTransform="Uppercase"/>
                    <Label Text="{Binding CurrentPace}" FontSize="48" TextColor="Cyan" HorizontalOptions="Center"/>
                    <Label Text="{x:Static resources:AppResources.Lbl_Min_Km}" TextColor="Gray" HorizontalOptions="Center"/>
                </VerticalStackLayout>
                <VerticalStackLayout>
                    <Label Text="{x:Static resources:AppResources.Lbl_Incline}" TextColor="Gray" FontSize="12" HorizontalOptions="Center" TextTransform="Uppercase"/>
                    <Label Text="{Binding CurrentIncline}" FontSize="48" TextColor="Orange" HorizontalOptions="Center"/>
                    <Label Text="%" TextColor="Gray" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </HorizontalStackLayout>

            <Label Text="{Binding StatusRun}" FontSize="18" TextColor="Yellow" HorizontalOptions="Center"/>

            <!-- Contrôles Manuels (activés/désactivés via IsConnected) -->
            <VerticalStackLayout Spacing="20" IsEnabled="{Binding IsConnected}">
                <HorizontalStackLayout Spacing="15" HorizontalOptions="Center">
                    <Button Text="{x:Static resources:AppResources.Lbl_Speed_Up}" Command="{Binding DecreaseSpeedCommand}" MinimumWidthRequest="100" BackgroundColor="#333" TextColor="White"/>
                    <Button Text="{x:Static resources:AppResources.Lbl_Speed_Down}" Command="{Binding IncreaseSpeedCommand}" MinimumWidthRequest="100" BackgroundColor="#333" TextColor="White"/>
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="15" HorizontalOptions="Center">
                    <Button Text="{x:Static resources:AppResources.Lbl_Incline_Down}" Command="{Binding DecreaseInclineCommand}" MinimumWidthRequest="100" BackgroundColor="#333" TextColor="White"/>
                    <Button Text="{x:Static resources:AppResources.Lbl_Incline_Up}" Command="{Binding IncreaseInclineCommand}" MinimumWidthRequest="100" BackgroundColor="#333" TextColor="White"/>
                </HorizontalStackLayout>

                <!-- Start / Stop -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" WidthRequest="300" HorizontalOptions="Center">
                    <Button Grid.Column="0" Text="{x:Static resources:AppResources.Btn_Start}" Command="{Binding StartCommand}" BackgroundColor="#4CAF50" TextColor="White" FontAttributes="Bold"/>
                    <Button Grid.Column="1" Text="{x:Static resources:AppResources.Btn_Stop}" Command="{Binding StopCommand}" BackgroundColor="#F44336" TextColor="White" FontAttributes="Bold"/>
                </Grid>
            </VerticalStackLayout>

            <!-- Lancer le Plan d'Intervalles -->
            <Button Text="{x:Static resources:AppResources.Btn_Run_Plan}" Command="{Binding RunPlanCommand}" BackgroundColor="#FF5722" TextColor="White" WidthRequest="300"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>