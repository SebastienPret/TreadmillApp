<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:resources="clr-namespace:TreadmillApp.Resources.Strings"
             xmlns:viewmodels="clr-namespace:TreadmillApp.ViewModels"
             xmlns:ble="clr-namespace:Plugin.BLE.Abstractions.Contracts;assembly=Plugin.BLE.Abstractions"
             x:Class="TreadmillApp.Views.ScanDevicesPage"
             Title="Recherche de Tapis">

    <ContentPage.BindingContext>
        <viewmodels:ScanDevicesViewModel />
    </ContentPage.BindingContext>

    <VerticalStackLayout Spacing="15" Padding="20">
        <!-- 🔍 Lancer le Scan FTMS -->
        <Button Text="{x:Static resources:AppResources.Txt_Start_Scan}" 
                Command="{Binding StartScanCommand}" 
                Style="{StaticResource PrimaryButton}"/>

        <ActivityIndicator IsRunning="{Binding IsScanning}" Style="{StaticResource ActivityIndicator}"/>

        <!-- Tapis détectés : -->
        <Label Text="{x:Static resources:AppResources.Txt_Detected_Treadmills}" Style="{StaticResource SectionLabel}"/>

        <CollectionView x:Name="CvDevices" 
                        ItemsSource="{Binding DiscoveredDevices}" 
                        SelectionMode="Single" 
                        SelectionChanged="OnDeviceSelected" 
                        HeightRequest="400">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="ble:IDevice">
                    <VerticalStackLayout Padding="10" Spacing="2">
                        <Label Text="{Binding Name}" Style="{StaticResource SectionLabel}"/>
                        <Label Text="{Binding Id, StringFormat='ID: {0}'}" Style="{StaticResource SubtleLabel}"/>
                        <BoxView HeightRequest="1" Style="{StaticResource Divider}" Margin="0,5,0,0"/>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>