<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:resources="clr-namespace:TreadmillApp.Resources.Strings"
             x:Class="TreadmillApp.Views.ScanDevicesPage"
             Title="Recherche de Tapis"
             BackgroundColor="#121212">

    <VerticalStackLayout Spacing="15" Padding="20">
        <!-- 🔍 Lancer le Scan FTMS -->
        <Button Text="{x:Static resources:AppResources.Txt_Start_Scan}" Clicked="OnScanClicked" BackgroundColor="#2196F3" TextColor="White"/>
        <ActivityIndicator x:Name="Loader" IsRunning="False" Color="Cyan"/>

        <!-- Tapis détectés : -->
        <Label Text="{x:Static resources:AppResources.Txt_Detected_Treadmills}" TextColor="White" FontSize="16"/>

        <CollectionView x:Name="CvDevices" SelectionMode="Single" SelectionChanged="OnDeviceSelected" HeightRequest="400">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout Padding="10" Spacing="2">
                        <Label Text="{Binding Name}" FontSize="18" TextColor="Yellow" FontAttributes="Bold"/>
                        <Label Text="{Binding Id, StringFormat='ID: {0}'}" FontSize="12" TextColor="Gray"/>
                        <BoxView HeightRequest="1" Color="#333" Margin="0,5,0,0"/>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>