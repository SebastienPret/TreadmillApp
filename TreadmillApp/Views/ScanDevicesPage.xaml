<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:resources="clr-namespace:TreadmillApp.Resources.Strings"
             xmlns:viewmodels="clr-namespace:TreadmillApp.ViewModels"
             
             xmlns:ble="clr-namespace:Plugin.BLE.Abstractions.Contracts;assembly=Plugin.BLE"
             x:Class="TreadmillApp.Views.ScanDevicesPage"
             x:DataType="viewmodels:ScanDevicesViewModel"
             BackgroundColor="{StaticResource PageBackground}">
    <!-- xmlns:ble="clr-namespace:Plugin.BLE.Abstractions.Contracts;assembly=Plugin.BLE.Abstractions" -->

    <ContentPage.BindingContext>
        <viewmodels:ScanDevicesViewModel />
    </ContentPage.BindingContext>
    

    <VerticalStackLayout Spacing="15" Padding="20">
        <!-- 🔍 Lancer le Scan FTMS -->
        <Button Text="{x:Static resources:AppResources.Txt_Start_Scan}"
                Command="{Binding StartScanCommand}"
                IsEnabled="{Binding IsNotConnecting}"
                BackgroundColor="{StaticResource AccentColor}"
                TextColor="{StaticResource AccentTextColor}"
                FontAttributes="Bold"
                HeightRequest="48"
                CornerRadius="8"/>
        <!-- Style="{StaticResource PrimaryButton}" -->

        <ActivityIndicator IsRunning="{Binding IsScanning}" 
                           Color="{StaticResource AccentColor}" 
                           HeightRequest="40"/>
        <!-- Style="{StaticResource ActivityIndicator}" -->

        <!-- Connexion en cours -->
        <VerticalStackLayout IsVisible="{Binding IsConnecting}" Spacing="8">
            <Label Text="{Binding ConnectingText}" 
                   TextColor="{StaticResource TextPrimary}"
                   FontSize="14"
                   HorizontalTextAlignment="Center"/>
            <!-- Style="{StaticResource StatusLabel}" -->
            <Button Text="{x:Static resources:AppResources.Txt_Cancel}"
                    Command="{Binding CancelConnectCommand}"
                    BackgroundColor="{StaticResource NeutralButton}"
                    TextColor="{StaticResource AccentTextColor}"
                    HeightRequest="40"
                    CornerRadius="8"/>
            <!-- Style="{StaticResource SecondaryButton}" -->
        </VerticalStackLayout>

        <!-- Tapis détectés : -->
        <Label Text="{x:Static resources:AppResources.Txt_Detected_Treadmills}"
               TextColor="{StaticResource TextPrimary}"
               FontSize="16"
               FontAttributes="Bold"/>
        <!--  Style="{StaticResource SectionLabel}" -->

        <CollectionView x:Name="CvDevices" 
                        ItemsSource="{Binding DiscoveredDevices}" 
                        SelectionMode="Single" 
                        SelectionChanged="OnDeviceSelected" 
                        IsEnabled="{Binding IsNotConnecting}"
                        HeightRequest="400">
            <CollectionView.Triggers>
                <DataTrigger TargetType="CollectionView" Binding="{Binding IsConnecting}" Value="True">
                    <Setter Property="Opacity" Value="0.4"/>
                </DataTrigger>
            </CollectionView.Triggers>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="ble:IDevice">
                    <Border Padding="12" 
                            Margin="0,4" 
                            BackgroundColor="{StaticResource SurfaceColor}"
                            Stroke="{StaticResource DividerColor}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Name}" 
                                   TextColor="{StaticResource TextPrimary}"
                                   FontAttributes="Bold" 
                                   FontSize="15"/>
                            <Label Text="{Binding Id, StringFormat='ID: {0}'}" 
                                   TextColor="{StaticResource TextSecondary}"
                                   FontSize="12"/>
                            <BoxView HeightRequest="1" 
                                     Color="{StaticResource DividerColor}" 
                                     Margin="0,6,0,0"/>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>