<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:resources="clr-namespace:TreadmillApp.Resources.Strings"
             x:Class="TreadmillApp.Views.IntervalsPage"
             BackgroundColor="#121212">
    
    <ScrollView x:Name="MyScrollView">
        <VerticalStackLayout Spacing="15" Padding="20">
            <!-- Nommer votre série d'intervalle -->
            <Label Text="{x:Static resources:AppResources.Lbl_Interval_Name}" FontSize="20" FontAttributes="Bold" TextColor="White"/>
            <!-- En haut, pour nommer le plan global -->
            <!-- Nom de l'entraînement (ex: HIIT Matinal) -->
            <!-- Mon Entraînement -->
            <Entry x:Name="TxtPlanTitle" Placeholder="{x:Static resources:AppResources.Placeholder_Workout_Title}" Text="{x:Static resources:AppResources.DefaultWorkoutTitle}" TextColor="White" BackgroundColor="#222"/>
            <!-- Configurer un nouvel intervalle -->
            <Label Text="{x:Static resources:AppResources.Lbl_Configure_Interval}" FontSize="20" FontAttributes="Bold" TextColor="White"/>

            <!-- Nom (ex: Sprint, Récup) -->
            <Entry x:Name="TxtName" Placeholder="{x:Static resources:AppResources.Placeholder_Interval_Name}" TextColor="White" PlaceholderColor="Gray"/>

            <HorizontalStackLayout Spacing="10">
                <!-- Vitesse (km/h): -->
                <Label Text="{x:Static resources:AppResources.Lbl_Speed_Km_H}" TextColor="White" VerticalTextAlignment="Center"/>
                <Stepper x:Name="StpSpeed" Minimum="1" Maximum="20" Increment="0.5" ValueChanged="StpSpeed_ValueChanged"/>
                <!-- <Label x:Name="LblSpeed" Text="1.0" TextColor="Cyan" VerticalTextAlignment="Center" FontSize="18"/> -->
                <Entry x:Name="LblSpeed" Text="1.0" Keyboard="Numeric" TextColor="Cyan"/>
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="10">
                <!-- Inclinaison (%): -->
                <Label Text="{x:Static resources:AppResources.Lbl_Incline_per}" TextColor="White" VerticalTextAlignment="Center"/>
                <Stepper x:Name="StpIncline" Minimum="0" Maximum="15" Increment="1" ValueChanged="StpIncline_ValueChanged"/>
                <Label x:Name="LblIncline" Text="0" TextColor="Cyan" VerticalTextAlignment="Center" FontSize="18"/>
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="10">
                <!-- Durée (sec): -->
                <Label Text="{x:Static resources:AppResources.Lbl_Duration}" TextColor="White" VerticalTextAlignment="Center"/>
                <Entry x:Name="TxtDuration" Text="{Binding DurationSeconds, Mode=TwoWay}" Keyboard="Numeric" TextColor="White" TextChanged="OnSecondsTextChanged" IsEnabled="False"/>
            </HorizontalStackLayout>
            <HorizontalStackLayout Spacing="10">
                <Label Text="{x:Static resources:AppResources.Lbl_Duration_Min}" VerticalOptions="Center" />

                <!-- Saisie de la durée en minutes -->
                <Entry x:Name="TxtDurationMinutes"  Text="{Binding DurationMinutes, Mode=TwoWay}" Keyboard="Numeric" HorizontalTextAlignment="Center" TextChanged="OnMinutesTextChanged"/>
            </HorizontalStackLayout>

            <!-- Ajouter à l'entraînement -->
            <Button Text="{x:Static resources:AppResources.Btn_Add_Interval}" Clicked="OnAddIntervalClicked" BackgroundColor="#FF5722" TextColor="White"/>

            <BoxView HeightRequest="1" Color="Gray" Margin="0,10"/>

            <!-- Liste des intervalles : -->
            <Label Text="{x:Static resources:AppResources.Lbl_Interval_List}" FontSize="16" TextColor="White"/>

            <CollectionView x:Name="CvIntervals" MinimumHeightRequest="10" MaximumHeightRequest="500">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <HorizontalStackLayout Spacing="15" Padding="5" VerticalOptions="Center">
                            <Label Text="{Binding Name}" TextColor="Yellow" WidthRequest="100" VerticalTextAlignment="Center"/>
                            <Label Text="{Binding TargetSpeed, StringFormat='{}V: {0} km/h'}" TextColor="White" WidthRequest="100" VerticalTextAlignment="Center"/>
                            <Label Text="{Binding DurationSeconds, StringFormat='{}T: {0}s'}" TextColor="White" WidthRequest="60" VerticalTextAlignment="Center"/>

                            <!-- Bouton pour supprimer un intervalle spécifique -->
                            <Button Text="❌" Clicked="OnDeleteIntervalClicked" CommandParameter="{Binding .}" BackgroundColor="Transparent" TextColor="Red" WidthRequest="40"/>
                        </HorizontalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Lancer cet entraînement -->
            <Button Text="{x:Static resources:AppResources.Btn_Start_Workout}" Clicked="OnStartWorkoutClicked" BackgroundColor="#4CAF50" TextColor="White" FontAttributes="Bold"/>
            <!-- 💾 Sauvegarder cet entraînement -->
            <Button Text="{x:Static resources:AppResources.Btn_Save_Workout}" Clicked="OnSaveWorkoutClicked" BackgroundColor="#00838F" TextColor="White"/>
        </VerticalStackLayout>
        
        
    </ScrollView>
</ContentPage>