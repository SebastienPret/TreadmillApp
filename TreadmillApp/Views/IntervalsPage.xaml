<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:resources="clr-namespace:TreadmillApp.Resources.Strings"
             xmlns:viewmodels="clr-namespace:TreadmillApp.ViewModels"
             xmlns:models="clr-namespace:TreadmillApp.Models"
             x:Class="TreadmillApp.Views.IntervalsPage"
             BackgroundColor="#121212">

    <ContentPage.BindingContext>
        <viewmodels:IntervalsViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Spacing="10" Padding="20">
            <!-- Nommer votre série d'intervalle -->
            <Label Text="{x:Static resources:AppResources.Lbl_Interval_Name}" FontSize="20" FontAttributes="Bold" TextColor="White"/>

            <Entry Placeholder="{x:Static resources:AppResources.Placeholder_Workout_Title}" 
                   Text="{Binding PlanTitle}" 
                   TextColor="White" BackgroundColor="#222"/>

            <!-- Configurer un nouvel intervalle -->
            <Label Text="{x:Static resources:AppResources.Lbl_Configure_Interval}" FontSize="20" FontAttributes="Bold" TextColor="White"/>

            <Entry Placeholder="{x:Static resources:AppResources.Placeholder_Interval_Name}" 
                   Text="{Binding IntervalName}" 
                   TextColor="White" PlaceholderColor="Gray"/>

            <HorizontalStackLayout Spacing="10">
                <Label Text="{x:Static resources:AppResources.Lbl_Speed_Km_H}" TextColor="White" VerticalTextAlignment="Center"/>
                <Stepper Minimum="0" Maximum="20" Increment="0.5" Value="{Binding Speed}"/>
                <Entry Text="{Binding Speed, StringFormat='{}{0:0.0}'}" Keyboard="Numeric" TextColor="Cyan"/>
            </HorizontalStackLayout>

            <!-- Pace -->
            <Label Text="{Binding PaceFormatted}" TextColor="Cyan" VerticalTextAlignment="Center" FontSize="15" HorizontalTextAlignment="Center"/>

            <HorizontalStackLayout Spacing="10">
                <Label Text="{x:Static resources:AppResources.Lbl_Incline_per}" TextColor="White" VerticalTextAlignment="Center"/>
                <Stepper Minimum="0" Maximum="15" Increment="1" Value="{Binding Incline}"/>
                <Label Text="{Binding Incline, StringFormat='{}{0:0}'}" TextColor="Cyan" VerticalTextAlignment="Center" FontSize="18"/>
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="10">
                <Label Text="{x:Static resources:AppResources.Lbl_Duration_Min}" VerticalOptions="Center" TextColor="White"/>
                <Entry Text="{Binding DurationMinutes, Mode=TwoWay}" Keyboard="Numeric" HorizontalTextAlignment="Center"/>

                <Label Text="{x:Static resources:AppResources.Lbl_Duration}" TextColor="White" VerticalTextAlignment="Center"/>
                <Entry Text="{Binding DurationSeconds, Mode=TwoWay}" Keyboard="Numeric" TextColor="White" IsEnabled="False"/>
            </HorizontalStackLayout>

            <!-- Ajouter à l'entraînement -->
            <Button Text="{x:Static resources:AppResources.Btn_Add_Interval}" 
                    Command="{Binding AddIntervalCommand}" 
                    BackgroundColor="#FF5722" TextColor="White"/>

            <BoxView HeightRequest="1" Color="Gray" Margin="0,10"/>

            <!-- Liste des intervalles -->
            <Label Text="{x:Static resources:AppResources.Lbl_Interval_List}" FontSize="16" TextColor="White"/>

            <CollectionView ItemsSource="{Binding Intervals}" MinimumHeightRequest="10" MaximumHeightRequest="500" >
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:WorkoutInterval">
                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Always" VerticalScrollBarVisibility="Never">
                            <HorizontalStackLayout Spacing="15" Padding="5" VerticalOptions="Center" HorizontalOptions="Start">
                                <Label Text="{Binding Name}" TextColor="Yellow" VerticalTextAlignment="Center"/>
                                <Label Text="{Binding TargetSpeed, StringFormat='{}S: {0} km/h'}" TextColor="White" VerticalTextAlignment="Center"/>
                                <Label Text="{Binding PaceFormattedString, StringFormat='{}P: {0}'}" TextColor="Cyan" VerticalTextAlignment="Center"/>
                                <Label Text="{Binding TargetIncline, StringFormat='{}I: {0}%'}" TextColor="White" VerticalTextAlignment="Center"/>
                                <Label Text="{Binding DurationMinutes, StringFormat='{}D: {0}m'}" TextColor="White" VerticalTextAlignment="Center"/>

                                <!-- Bouton de suppression lié via Command et CommandParameter -->
                                <!--<Button Text="❌" 
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:IntervalsViewModel}}, Path=DeleteIntervalCommand}" 
                                        CommandParameter="{Binding .}" 
                                        BackgroundColor="Transparent" TextColor="Red" WidthRequest="40"/>
                                -->
                                <Button Text="❌"
                                        Clicked="OnDeleteIntervalClicked"
                                        BackgroundColor="Transparent" TextColor="Red" WidthRequest="40"/>
                            </HorizontalStackLayout>
                        </ScrollView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Lancer cet entraînement -->
            <Button Text="{x:Static resources:AppResources.Btn_Start_Workout}" 
                    Command="{Binding StartWorkoutCommand}" 
                    BackgroundColor="#4CAF50" TextColor="White" FontAttributes="Bold"/>

            <!-- Sauvegarder cet entraînement -->
            <Button Text="{x:Static resources:AppResources.Btn_Save_Workout}" 
                    Command="{Binding SaveWorkoutCommand}" 
                    BackgroundColor="#00838F" TextColor="White"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>