<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:TreadmillApp.Models"
             xmlns:resources="clr-namespace:TreadmillApp.Resources.Strings"
             xmlns:viewmodels="clr-namespace:TreadmillApp.ViewModels"
             x:Class="TreadmillApp.Views.SavedWorkoutsPage"
             x:Name="thisPage"
             BackgroundColor="#121212">

    <ContentPage.BindingContext>
        <viewmodels:SavedWorkoutsViewModel x:Name="ViewModel" />
    </ContentPage.BindingContext>

    <VerticalStackLayout Spacing="20" Padding="20">
        <!-- Choisissez un programme enregistré : -->
        <Label Text="{x:Static resources:AppResources.Txt_Choose_Workout}" FontSize="18" TextColor="White"/>
        <ScrollView>
            <CollectionView ItemsSource="{Binding SavedWorkouts}" HeightRequest="450">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:WorkoutPlan">

                        <Border BackgroundColor="#1E1E1E" StrokeShape="RoundRectangle 10" Padding="10,0">

                            <FlexLayout Direction="Row" 
                                        Wrap="Wrap" 
                                        JustifyContent="SpaceBetween" 
                                        AlignItems="Center">
                                <VerticalStackLayout Padding="5" Margin="0,2">
                                    <Label Text="{Binding Title}" FontSize="20" TextColor="Yellow" FontAttributes="Bold"/>
                                    <HorizontalStackLayout Spacing="10" >
                                        <Label Text="{x:Static resources:AppResources.Txt_Intervals_Count}" FontSize="14" TextColor="Gray"/>
                                        <Label Text="{Binding Intervals.Count}" FontSize="14" TextColor="Gray"/>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>


                                <HorizontalStackLayout Spacing="10" Padding="0,10"  Margin="0,0" HorizontalOptions="Center">
                                    <!-- Boutons d'actions avec des événements Clicked (100% stable) -->
                                    <!-- ▶️ Lancer -->
                                    <Button Text="{x:Static resources:AppResources.Txt_Run_Workout}" 
                                        Clicked="OnRunClicked" 
                                        BackgroundColor="#4CAF50" TextColor="White" HeightRequest="35" FontSize="12"/>

                                    <!-- ✏️ Modifier -->
                                    <Button Text="{x:Static resources:AppResources.Txt_Edit_Workout}" 
                                        Clicked="OnEditClicked" 
                                        BackgroundColor="#FF9800" TextColor="White" HeightRequest="35" FontSize="12"/>

                                    <!-- 🗑️ Supprimer -->
                                    <Button Text="{x:Static resources:AppResources.Txt_Delete_Workout}" 
                                        Clicked="OnDeleteClicked" 
                                        BackgroundColor="#F44336" TextColor="White" HeightRequest="35" FontSize="12"/>
                                </HorizontalStackLayout>
                            </FlexLayout>
                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </ScrollView>
        <BoxView HeightRequest="1" Color="#333" Margin="0,5,0,0"/>
        <!-- ➕ Créer un nouvel entraînement -->
        <Button Text="{x:Static resources:AppResources.Txt_Create_New_Workout}" 
                Command="{Binding CreateNewCommand}" 
                BackgroundColor="#2196F3" TextColor="White"/>
    </VerticalStackLayout>

</ContentPage>