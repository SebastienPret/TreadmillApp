<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Tous les styles utilisent DynamicResource : ils se mettent à jour
         automatiquement quand le thème change. -->

    <!-- ===================== Pages & Shell ===================== -->
    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{DynamicResource PageBackground}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{DynamicResource SurfaceColor}" />
        <Setter Property="Shell.ForegroundColor" Value="{DynamicResource AccentColor}" />
        <Setter Property="Shell.TitleColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Shell.DisabledColor" Value="{DynamicResource TextSecondary}" />
        <Setter Property="Shell.UnselectedColor" Value="{DynamicResource TextSecondary}" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{DynamicResource SurfaceColor}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{DynamicResource AccentColor}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{DynamicResource AccentColor}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{DynamicResource TextSecondary}" />
    </Style>

    <!-- ===================== Labels ===================== -->
    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="TitleLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="SectionLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <!-- Valeurs mises en avant (pace, vitesse...) -->
    <Style x:Key="ValueLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource HighlightColor}" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <!-- Nom d'un intervalle dans la liste -->
    <Style x:Key="IntervalNameLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource WarningColor}" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="HintLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- ===================== Champs de saisie ===================== -->
    <Style x:Key="BaseEntry" TargetType="Entry">
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource TextSecondary}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceAlt}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Style implicite : tous les Entry héritent du style de base -->
    <Style TargetType="Entry" BasedOn="{StaticResource BaseEntry}" />

    <!-- Entry pour valeur numérique mise en avant -->
    <Style x:Key="ValueEntry" TargetType="Entry" BasedOn="{StaticResource BaseEntry}">
        <Setter Property="TextColor" Value="{DynamicResource HighlightColor}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="Keyboard" Value="Numeric" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="TitleColor" Value="{DynamicResource TextSecondary}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceAlt}" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{DynamicResource AccentColor}" />
    </Style>

    <!-- ===================== Boutons ===================== -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource AccentColor}" />
        <Setter Property="TextColor" Value="{DynamicResource AccentTextColor}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="MinimumHeightRequest" Value="46" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource DividerColor}" />
                            <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.8" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Style implicite : tous les Button héritent du style principal -->
    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}" />

    <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="BackgroundColor" Value="{DynamicResource SuccessColor}" />
        <Setter Property="TextColor" Value="#FFFFFF" />
    </Style>

    <Style x:Key="InfoButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="BackgroundColor" Value="{DynamicResource InfoColor}" />
        <Setter Property="TextColor" Value="#FFFFFF" />
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="BackgroundColor" Value="{DynamicResource NeutralButton}" />
        <Setter Property="TextColor" Value="#FFFFFF" />
    </Style>
    
    <!-- danger button -->
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="BackgroundColor" Value="{DynamicResource DangerColor}" />
        <Setter Property="TextColor" Value="#FFFFFF" />
    </Style>

    <!-- Boutons icône (✏️ / ❌) dans la liste -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="WidthRequest" Value="44" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="DangerIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="TextColor" Value="{DynamicResource DangerColor}" />
    </Style>

    <!-- ===================== Divers ===================== -->
    <Style x:Key="Divider" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Color" Value="{DynamicResource DividerColor}" />
        <Setter Property="Margin" Value="0,10" />
    </Style>

    <!-- Carte : <Border Style="{StaticResource Card}"> -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
        <Setter Property="Stroke" Value="{DynamicResource DividerColor}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Padding" Value="12" />
    </Style>
</ResourceDictionary>
