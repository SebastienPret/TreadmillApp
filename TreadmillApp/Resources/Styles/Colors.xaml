<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ===== Palette de marque (identique à l'icône) =====
         Ces couleurs sont fixes : elles ne changent pas avec le thème.
         Les couleurs qui changent selon le style sont dans Resources/Themes/*.xaml -->

    <Color x:Key="BrandOrange">#FF5722</Color>
    <Color x:Key="BrandCyan">#00E5FF</Color>
    <Color x:Key="BrandDark">#121212</Color>
    <Color x:Key="BrandGreen">#4CAF50</Color>
    <Color x:Key="BrandTeal">#00838F</Color>
    <Color x:Key="BrandYellow">#FFEB3B</Color>

    <!-- Compatibilité avec le modèle MAUI (splash screen, etc.) -->
    <Color x:Key="Primary">#FF5722</Color>
    <Color x:Key="PrimaryDark">#121212</Color>
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
</ResourceDictionary>
