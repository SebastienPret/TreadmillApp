<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    x:Class="TreadmillApp.Resources.Themes.DarkTheme">

    <!-- Thème SOMBRE : mêmes clés dans tous les thèmes, seules les valeurs changent -->

    <Color x:Key="PageBackground">#121212</Color>
    <Color x:Key="SurfaceColor">#1E1E1E</Color>
    <Color x:Key="SurfaceAlt">#222222</Color>
    <Color x:Key="DividerColor">#444444</Color>

    <Color x:Key="TextPrimary">#FFFFFF</Color>
    <Color x:Key="TextSecondary">#9E9E9E</Color>

    <Color x:Key="AccentColor">#FF5722</Color>
    <Color x:Key="AccentTextColor">#FFFFFF</Color>
    <Color x:Key="HighlightColor">#00E5FF</Color>
    <Color x:Key="WarningColor">#FFEB3B</Color>
    <Color x:Key="SuccessColor">#4CAF50</Color>
    <Color x:Key="InfoColor">#00838F</Color>
    <Color x:Key="DangerColor">#FF5252</Color>
    <Color x:Key="NeutralButton">#555555</Color>
</ResourceDictionary>
