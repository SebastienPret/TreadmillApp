<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    x:Class="TreadmillApp.Resources.Themes.LightTheme">

    <!-- Thème CLAIR : le cyan et le jaune sont assombris pour rester lisibles sur fond blanc -->

    <Color x:Key="PageBackground">#F5F5F5</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceAlt">#EAEAEA</Color>
    <Color x:Key="DividerColor">#CFCFCF</Color>

    <Color x:Key="TextPrimary">#212121</Color>
    <Color x:Key="TextSecondary">#757575</Color>

    <Color x:Key="AccentColor">#E64A19</Color>
    <Color x:Key="AccentTextColor">#FFFFFF</Color>
    <Color x:Key="HighlightColor">#00838F</Color>
    <Color x:Key="WarningColor">#B26A00</Color>
    <Color x:Key="SuccessColor">#388E3C</Color>
    <Color x:Key="InfoColor">#00695C</Color>
    <Color x:Key="DangerColor">#D32F2F</Color>
    <Color x:Key="NeutralButton">#757575</Color>
</ResourceDictionary>
